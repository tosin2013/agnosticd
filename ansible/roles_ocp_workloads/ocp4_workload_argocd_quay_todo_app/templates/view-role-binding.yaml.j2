kind: RoleBinding
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: view-role-binding-gitea-{{ user }}
  namespace: {{ namespace }}
subjects:
  - kind: User
    apiGroup: rbac.authorization.k8s.io
    name: {{ user }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: view
