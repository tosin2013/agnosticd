apiVersion: tekton.dev/v1
kind: Pipeline
metadata:
  labels:
    app: todo-demo-app
  name: argocd-quay-todo-demo-app-pipeline-{{ user }}
  namespace: {{ namespace }}
spec:
  params:
    - default: latest
      description: Image Tag Value
      name: IMAGE_TAG
      type: string
    - default: CHANGEME
      description: Current Image Tag Value
      name: CURRENT_IMAGE_TAG
      type: string
    - default: 'quay.io/takinosh/todo-demo-app:v1'
      name: quay-io-repository
      type: string
    - default: latest
      name: quay-io-image-tag-name
      type: string
    - default: gitea-gitea.apps.cluster-2wcqt.2wcqt.sandbox80.opentlc.com/{{ user }}/todo-demo-app-helmrepo
      name: GIT_REPOSITORY
      type: string
    - default: pipeline@example.com
      name: GIT_EMAIL
      type: string
    - default: todo-demo-app
      name: GIT_NAME
      type: string
    - default: '1'
      name: REPLICA_COUNT
      type: string
    - name: GIT_USERNAME
      type: string
    - name: GIT_TOKEN
      type: string
  tasks:
    - name: fetch-repository
      params:
        - name: url
          value: 'https://github.com/tosin2013/todo-demo-app'
        - name: revision
          value: master
        - name: subdirectory
          value: ''
        - name: deleteExisting
          value: 'true'
      taskRef:
        kind: ClusterTask
        name: git-clone
      workspaces:
        - name: output
          workspace: shared-workspace-{{ user }}
    - name: maven-run
      params:
        - name: CONTEXT_DIR
          value: .
        - name: GOALS
          value:
            - '-DskipTests'
            - clean
            - package
      runAfter:
        - fetch-repository
      taskRef:
        kind: ClusterTask
        name: maven
      workspaces:
        - name: maven-settings
          workspace: maven-settings-{{ user }}
        - name: source
          workspace: shared-workspace-{{ user }}
    - name: build-java-app-image
      params:
        - name: CONTEXT
          value: .
        - name: DOCKERFILE
          value: src/main/docker/Dockerfile
        - name: IMAGE
          value: 'image-registry.openshift-image-registry.svc:5000/{{ namespace }}/{{ namespace }}-image:latest'
        - name: TLSVERIFY
          value: 'false'
      runAfter:
        - maven-run
      taskRef:
        kind: ClusterTask
        name: buildah
      workspaces:
        - name: source
          workspace: shared-workspace-{{ user }}
    - name: tag-test-image
      params:
        - name: SCRIPT
          value: |
            oc tag {{ namespace }}-image:latest {{ namespace }}-image:$(params.IMAGE_TAG)
      runAfter:
        - build-java-app-image
      taskRef:
        kind: ClusterTask
        name: openshift-client
    - name: push-todo-demo-app-image-to-quay-{{ user }}
      params:
        - name: quay-io-repository
          value: $(params.quay-io-repository)
        - name: quay-io-image-tag-name
          value: $(params.quay-io-image-tag-name)
      runAfter:
        - tag-test-image
      taskRef:
        kind: Task
        name: push-todo-demo-app-image-to-quay-{{ user }}
      workspaces:
        - name: helm-shared-workspace-{{ user }}
          workspace: helm-shared-workspace-{{ user }}
    - name: update-image-tag-in-git
      params:
        - name: GIT_REPOSITORY
          value: $(params.GIT_REPOSITORY)
        - name: GIT_EMAIL
          value: pipeline@example.com
        - name: GIT_NAME
          value: todo-demo-app
        - name: GIT_MANIFEST_DIR
          value: .
        - name: TARGET_IMAGE
          value: $(params.quay-io-repository)
        - name: TARGET_TAG
          value: $(params.quay-io-image-tag-name)
        - name: REPLICA_COUNT
          value: $(params.REPLICA_COUNT)
        - name: GIT_USERNAME
          value: $(params.GIT_USERNAME)
        - name: GIT_TOKEN
          value: $(params.GIT_TOKEN)
      runAfter:
        - push-todo-demo-app-image-to-quay-{{ user }}
      taskRef:
        kind: Task
        name: update-image-tag-in-git
      workspaces:
        - name: source-workspace-{{ user }}
          workspace: shared-workspace-{{ user }}
    - name: argocd-task-sync-and-wait
      params:
        - name: application-name
          value: {{ namespace }}
        - name: revision
          value: main
      runAfter:
        - update-image-tag-in-git
      taskRef:
        kind: ClusterTask
        name: argocd-task-sync-and-wait
  workspaces:
    - name: shared-workspace-{{ user }}
    - name: maven-settings-{{ user }}
    - name: helm-shared-workspace-{{ user }}
